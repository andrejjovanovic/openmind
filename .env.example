# Optional: enables AI titles, summaries and tags (including for images) on save.
# Without it OpenMind works fully offline apart from fetching the links you save.
ANTHROPIC_API_KEY=

# Model used for tagging. claude-haiku-5-5 is much cheaper and fine for this job.
OPENMIND_AI_MODEL=claude-opus-5-5

# Where the SQLite database and images live (default: ./data).
OPENMIND_DATA_DIR=

# Set to 1 to allow saving links that point at private/loopback addresses.
OPENMIND_ALLOW_PRIVATE_URLS=

# Set to 1 to stop new accounts being created once yours exist.
OPENMIND_DISABLE_SIGNUP=

# --- Single sign-on (any OpenID Connect provider, e.g. Pocket ID) ---
# Register OpenMind in the provider with callback URL <OPENMIND_URL>/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave empty if the client is registered as a public client (PKCE only).
OIDC_CLIENT_SECRET=
# Label on the login button: "Continue with <OIDC_NAME>".
OIDC_NAME=Pocket ID
# The address people reach OpenMind at. Recommended behind a reverse proxy.
OPENMIND_URL=
# Set to 1 to hide the email/password form and allow SSO only.
OPENMIND_DISABLE_PASSWORD_LOGIN=
# Set to 1 to let SSO attach to an existing account by email even when the
# provider does not mark the address as verified.
OIDC_TRUST_UNVERIFIED_EMAIL=
